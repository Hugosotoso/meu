# O modo de demonstração funciona sem estas variáveis.
# Configure-as somente após criar autenticação real e políticas RLS no Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL

# Mantenha false em hospedagens públicas até implementar autenticação real.
EXPO_PUBLIC_ENABLE_REMOTE_LOOKUP=false
